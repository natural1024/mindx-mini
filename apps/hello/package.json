    "@mindx/eslint-config": "workspace:*",
    "@rspack/cli": "^1.0.0",
    "@rspack/core": "^1.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
