{
  "name": "@mindx/app-hello",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development rspack serve -c rspack.config.mjs",
    "dist": "NODE_ENV=production rspack build -c rspack.config.mjs",
