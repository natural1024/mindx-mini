# commit-msg hook
# 详细规范：docs/release-workflow.md §1, §2

# 1. commitlint：基础类型 / 长度 / 末尾 issue ref 正则校验
npx commitlint --edit "$1" || exit 1

# 2. check-commit-issue-ref：角色 × type 矩阵 + 工蜂 API issue 真实性校验（本地降级模式）
node scripts/workflow/check-commit-issue-ref.mjs "$1" || exit 1

# 3. check-chore-no-issue-abuse：chore/no-issue diff 路径体检（业务区命中 → 阻塞，可用 [skip-issue] 豁免）
node scripts/workflow/check-chore-no-issue-abuse.mjs "$1" || exit 1
