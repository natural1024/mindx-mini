{
  "name": "@mindx/build-config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared rspack build config for mindx",
  "type": "module",
  "exports": {
    "./rspack/library": "./dist/rspack/library.js",
    "./rspack/app": "./dist/rspack/app.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "pnpm build && node --test rspack/app.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@rspack/core": "^1.0.0",
    "@rspack/plugin-react-refresh": "^1.6.2",
    "@svgr/webpack": "^8.1.0",
    "browserslist": "^4.24.0",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "react-refresh": "^0.18.0",
    "typescript": "^5.7.0"
  }
}
